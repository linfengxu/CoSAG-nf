/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    linfengxu/CoSAG-nf Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

params {

    // Input options (required at run time: --input or -params-file)
    input                      = null

    // Output options (required at run time: --outdir)
    outdir                     = null
    publish_dir_mode           = 'copy'
    keep_intermediate          = false

    // -------------------------------------------------------------------------
    // Output directory structure
    // -------------------------------------------------------------------------
    out_individual_assemblies    = '01_individual_assemblies'
    out_similarity_analysis      = '02_similarity_analysis'
    out_clustering_analysis      = '03_clustering_analysis'
    out_co_assemblies            = '04_co_assemblies'
    out_taxonomic_classification = '05_taxonomic_classification'
    out_final_results            = '06_final_results'
    out_logs_diagnostics         = '07_logs_and_diagnostics'

    // -------------------------------------------------------------------------
    // SPAdes assembly options
    // -------------------------------------------------------------------------
    spades_kmers               = '21,33,55'
    spades_sc                  = true
    spades_careful             = true
    spades_additional_args     = '--cov-cutoff 2 --phred-offset 33'

    // -------------------------------------------------------------------------
    // CheckM2 quality filtering
    // -------------------------------------------------------------------------
    checkm2_db                              = null   // required: path to CheckM2 reference .dmnd
    checkm2_additional_args                 = ''
    // Final CoSAG quality thresholds (strict)
    min_completeness                        = 50
    max_contamination                       = 10
    // Round-1 co-assembly filter threshold (lenient — only remove obvious failures)
    round                         = 1      // 主入口选择：1=完整流程，2=执行 round2 workflow
    round1_updated_json           = null   // round=2 时必填：Round1 UPDATE_CLUSTER_JSON 产物
    sag_bac_summary               = null   // round=2 可选：all_sags bac120 summary
    sag_ar_summary                = null   // round=2 可选：all_sags ar53 summary

    cosag_optimize                = true
    cosag_opt_min_completeness    = 90.0
    cosag_opt_max_contamination   = 10.0
    

    // -------------------------------------------------------------------------
    // Sourmash / MinHash clustering
    // -------------------------------------------------------------------------
    sourmash_ksize                  = 51
    sourmash_scaled                 = 100
    sourmash_min_similarity         = 0.05
    sourmash_filter_small_sketches = false  // 默认不过滤，保留所有 sig
    sourmash_enable_quality_filter  = false  // disabled by default
    sourmash_min_sketch_size        = 100    // min hashes; SAGs below this are flagged
    sourmash_min_connections        = 1      // only used when quality_filter = true

    distance_metric                 = 'jaccard' //ani
    // -------------------------------------------------------------------------
    // Hierarchical clustering
    // -------------------------------------------------------------------------
    cluster_linkage_method              = 'complete'
    cluster_threshold                   = 0.95
    cluster_min_size                    = 2
    cluster_max_size                    = 50
    cluster_min_similarity_in_cluster   = 0.2
    cluster_distance_metric             = 'euclidean'
    cluster_criterion                   = 'inconsistent'
    cluster_generate_dendrogram         = true
    cluster_compute_validation          = true

    // -------------------------------------------------------------------------
    // GTDB-Tk taxonomic classification
    // -------------------------------------------------------------------------
    gtdb_database              = null   // required: path to GTDB-Tk reference data directory
    gtdb_min_perc_aa           = 10
    gtdb_skip_ani_screen       = true

    // -------------------------------------------------------------------------
    // QUALITY_TAXONOMY: barrnap + on HQ CoSAGs 
    // -------------------------------------------------------------------------
    run_cosag_rrna_annotation = true
    // -------------------------------------------------------------------------
    // Final HQ MAG metadata (after GTDB merge JSON only — does not change EXTRACT/GTDB inputs)
    // Standard: completeness > hq_mag_completeness_gt, contamination < hq_mag_contamination_lt,
    //           16S+23S+5S (barrnap)
    // -------------------------------------------------------------------------
    hq_mag_final_assessment   = true
    hq_mag_completeness_gt    = 90.0
    hq_mag_contamination_lt   = 5.0
    cosag_rounds                  = 1      // internal co-assembly rounds (1–3); see subworkflows/local/coassembly

    // -------------------------------------------------------------------------
    // CoSAG TNF optimization (SAG subset selection, no assembly/QC inside)
    // -------------------------------------------------------------------------
    tnf_min_clusters            = 2
    tnf_max_clusters            = 10
    tnf_max_distance            = 0.15   // mean pairwise TNF distance convergence threshold
    tnf_distance_percentile     = 90     // only remove SAGs above this percentile
    tnf_max_iterations          = 20
    tnf_min_sags                = 3
    tnf_n_candidates            = 3
// TNF optimiser (cosag_optimizer.py) acceptance targets — used by COSAG_OPTIMIZATION
    target_completeness           = 90.0
    target_contamination          = 5.0
    // -------------------------------------------------------------------------
    // Boilerplate options
    // -------------------------------------------------------------------------
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    hook_url                     = null
    version                      = false
    show_hidden                  = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name          = null
    config_profile_description   = null
    custom_config_version        = 'master'
    custom_config_base           = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact       = null
    config_profile_url           = null

    // Schema validation default options
    validate_params              = true

    // Resource limits
    max_memory                   = '480.GB'
    max_cpus                     = 20
    max_time                     = '24.h'
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        singularity.runOptions = "--bind /mnt"
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gitpod {
        executor.name           = 'local'
        executor.cpus           = 4
        executor.memory         = 8.GB
        process {
            resourceLimits = [
                memory: 8.GB,
                cpus  : 4,
                time  : 1.h
            ]
        }
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }

    // HPC profile for CPFS cluster
    hpc {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = '/cpfs01/projects-HDD/cfff-86962b7a8e68_HDD/public/singularity_sif'
        params {
            checkm2_db    = '/cpfs01/projects-HDD/cfff-86962b7a8e68_HDD/public/checkM_db/CheckM2_database/uniref100.KO.1.dmnd'
            gtdb_database = '/cpfs01/projects-HDD/cfff-86962b7a8e68_HDD/public/db/GTDB/release220'
        }
        executor {
            name      = 'slurm'
            queueSize = 50
        }
    }
}

// Load nf-core custom profiles from different institutions
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

process.shell = [
    "bash",
    "-C",
    "-e",
    "-u",
    "-o",
    "pipefail"
]

nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'linfengxu/CoSAG-nf'
    contributors    = [
        [
            name:         'Linfeng Xu',
            affiliation:  'School of Life Sciences, Fudan University',
            email:        '',
            github:       'linfengxu',
            contribution: ['author', 'maintainer'],
            orcid:        ''
        ],
    ]
    homePage        = 'https://github.com/linfengxu/CoSAG-nf'
    description     = 'Single-cell amplified genome co-assembly and quality filtering pipeline'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=24.04.2'
    version         = '1.0.0dev'
    doi             = ''
}

plugins {
    id 'nf-schema@2.3.0'
}

validation {
    monochromeLogs = params.monochrome_logs
    help {
        enabled             = true
        command             = "nextflow run linfengxu/CoSAG-nf -profile <docker/singularity/.../hpc> --input samplesheet.csv --outdir <OUTDIR>"
        fullParameter       = "help_full"
        showHiddenParameter = "show_hidden"
    }
}

includeConfig 'conf/modules.config'