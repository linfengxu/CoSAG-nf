/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    // ─────────────────────────────────────────────────────────────────────────
    // MODULE 1 — SAG Assembly
    // ─────────────────────────────────────────────────────────────────────────
    withName: /.*:SAG_ASSEMBLY:SPADES$/ {
        cpus   = 8
        memory = '64.GB'
        time   = '12.h'
        ext.args = ''
        publishDir = [
            [
                path:    { "${params.outdir}/${params.out_individual_assemblies}/per_sample/${meta.id}/contigs" },
                mode:    params.publish_dir_mode,
                pattern: "*_contigs.fasta"
            ],
            [
                path:    { "${params.outdir}/${params.out_individual_assemblies}/per_sample/${meta.id}/logs" },
                mode:    params.publish_dir_mode,
                pattern: "*_spades.log"
            ],
            [
                path:    { "${params.outdir}/${params.out_individual_assemblies}/per_sample/${meta.id}/graphs" },
                mode:    params.publish_dir_mode,
                pattern: "*_assembly_graph.gfa",
                saveAs:  { it ?: null }
            ]
        ]
    }

    withName: /.*:SAG_ASSEMBLY:CHECKM2$/ {
        cpus   = 16
        memory = '64.GB'
        time   = '12.h'
        ext.args = ''
        publishDir = [
            [
                path:    { "${params.outdir}/${params.out_individual_assemblies}/checkm2" },
                mode:    params.publish_dir_mode,
                pattern: "checkm2_results/quality_report.tsv"
            ],
            [
                path:    { "${params.outdir}/${params.out_logs_diagnostics}/checkm2/individual_sags" },
                mode:    params.publish_dir_mode,
                pattern: "checkm2_results.log"
            ]
        ]
    }

    withName: /.*:SAG_ASSEMBLY:FILTER_SAGS$/ {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
        ext.args = ''
        publishDir = [
            [
                path:    { "${params.outdir}/${params.out_logs_diagnostics}/filter_sags" },
                mode:    params.publish_dir_mode,
                pattern: "sags_fail.tsv"
            ],
            [
                path:    { "${params.outdir}/${params.out_logs_diagnostics}/filter_sags" },
                mode:    params.publish_dir_mode,
                pattern: "filter_stats.json"
            ]
        ]
    }

    withName: /.*:SAG_ASSEMBLY:GTDBTK_CLASSIFYWF$/ {
        cpus   = 24
        memory = '120.GB'
        time   = '24.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_taxonomic_classification}/individual_sags/gtdb_results" },
            mode:    params.publish_dir_mode,
            pattern: "gtdb_results/*"
        ]
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MODULE 2 — MinHash clustering
    // ─────────────────────────────────────────────────────────────────────────
    withName: /.*:MINHASH_CLUSTER:SOURMASH_SKETCH$/ {
        cpus   = 4
        memory = '16.GB'
        time   = '4.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_similarity_analysis}/signatures" },
            mode:    params.publish_dir_mode,
            pattern: "*.sig"
        ]
    }

    withName: /.*:MINHASH_CLUSTER:SOURMASH_COMPARE$/ {
        cpus   = 20
        memory = '320.GB'
        time   = '24.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_similarity_analysis}/matrix" },
            mode:    params.publish_dir_mode,
            pattern: "sourmash_compare.log"
        ]
    }

    withName: /.*:MINHASH_CLUSTER:SOURMASH_PROCESS_MATRIX$/ {
        cpus   = 4
        memory = '32.GB'
        time   = '4.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_similarity_analysis}/matrix" },
            mode:    params.publish_dir_mode,
            pattern: "*.{tsv,csv,txt}"
        ]
    }

    withName: /.*:MINHASH_CLUSTER:SOURMASH_QUALITY_FILTER$/ {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_similarity_analysis}/quality_filter" },
            mode:    params.publish_dir_mode,
            pattern: "*.{tsv,txt}"
        ]
    }

    withName: /.*:MINHASH_CLUSTER:HIERARCHICAL_CLUSTER_MATRIX$/ {
        cpus   = 4
        memory = '32.GB'
        time   = '4.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_clustering_analysis}/matrix" },
            mode:    params.publish_dir_mode,
            pattern: "*.{csv,txt}"
        ]
    }

    withName: /.*:MINHASH_CLUSTER:HIERARCHICAL_CLUSTER_ANALYSIS$/ {
        cpus   = 8
        memory = '64.GB'
        time   = '8.h'
        publishDir = [
            [
                path:    { "${params.outdir}/${params.out_clustering_analysis}/results" },
                mode:    params.publish_dir_mode,
                pattern: "*.{tsv,txt}"
            ],
            [
                path:    { "${params.outdir}/${params.out_clustering_analysis}/results" },
                mode:    params.publish_dir_mode,
                pattern: "dendrogram.png"
            ]
        ]
    }

    withName: /.*:MINHASH_CLUSTER:HIERARCHICAL_CLUSTER_REPORT$/ {
        cpus   = 2
        memory = '8.GB'
        time   = '2.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_clustering_analysis}/summary" },
            mode:    params.publish_dir_mode,
            pattern: "*.{tsv,txt}"
        ]
    }

    withName: /.*:MINHASH_CLUSTER:PREPARE_CLUSTER_JSON$/ {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_clustering_analysis}/cluster_json/round1" },
            mode:    params.publish_dir_mode,
            pattern: "round1_clusters.json"
        ]
    }

    withName: /.*:MINHASH_CLUSTER:PREPARE_ROUND_JSON$/ {
        cpus   = 16
        memory = '32.GB'
        time   = '4.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_clustering_analysis}/cluster_json/round2" },
            mode:    params.publish_dir_mode,
            pattern: "round*_clusters.json"
        ]
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MODULE 3 — Co-assembly
    // ─────────────────────────────────────────────────────────────────────────
    withName: /.*:COASSEMBLY(?::[^:]+)*:PREPARE_CLUSTER_READS$/ {
        cpus   = 4
        memory = '16.GB'
        time   = '4.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_co_assemblies}/merged_reads/${meta.id}" },
            mode:    params.publish_dir_mode,
            pattern: "*.log"
        ]
    }

    withName: /.*:COASSEMBLY(?::[^:]+)*:SPADES_COASSEMBLY$/ {
        cpus   = 16
        memory = '120.GB'
        time   = '24.h'
        ext.args = '--only-assembler'
        publishDir = [
            [
                path:    { "${params.outdir}/${params.out_co_assemblies}/coassembly/${meta.id}/contigs" },
                mode:    params.publish_dir_mode,
                pattern: "*_contigs.fasta"
            ],
            [
                path:    { "${params.outdir}/${params.out_co_assemblies}/coassembly/${meta.id}/logs" },
                mode:    params.publish_dir_mode,
                pattern: "*_spades.log"
            ]
        ]
    }

    withName: /.*:COASSEMBLY(?::[^:]+)*:CHECKM2_COASSEMBLY$/ {
        cpus   = 16
        memory = '64.GB'
        time   = '12.h'
        ext.args = ''
        publishDir = [
            [
                path:    { "${params.outdir}/${params.out_co_assemblies}/checkm2" },
                mode:    params.publish_dir_mode,
                pattern: "checkm2_results/quality_report.tsv"
            ],
            [
                path:    { "${params.outdir}/${params.out_logs_diagnostics}/checkm2/coassemblies" },
                mode:    params.publish_dir_mode,
                pattern: "checkm2_results.log"
            ]
        ]
    }

    withName: /.*:COASSEMBLY(?::[^:]+)*:UPDATE_CLUSTER_JSON$/ {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_co_assemblies}/cluster_json/latest" },
            mode:    params.publish_dir_mode,
            pattern: "updated_clusters.json"
        ]
    }

    // Round-specific cluster_json publication to avoid overwrite in multi-round runs
    withName: /.*:COASSEMBLY:COASSEMBLY_ROUND_1:UPDATE_CLUSTER_JSON$/ {
        publishDir = [
            path:    { "${params.outdir}/${params.out_co_assemblies}/cluster_json/round1" },
            mode:    params.publish_dir_mode,
            pattern: "updated_clusters.json"
        ]
    }
    withName: /.*:COASSEMBLY:COASSEMBLY_ROUND_2:UPDATE_CLUSTER_JSON$/ {
        publishDir = [
            path:    { "${params.outdir}/${params.out_co_assemblies}/cluster_json/round2" },
            mode:    params.publish_dir_mode,
            pattern: "updated_clusters.json"
        ]
    }
    withName: /.*:COASSEMBLY:COASSEMBLY_ROUND_3:UPDATE_CLUSTER_JSON$/ {
        publishDir = [
            path:    { "${params.outdir}/${params.out_co_assemblies}/cluster_json/round3" },
            mode:    params.publish_dir_mode,
            pattern: "updated_clusters.json"
        ]
    }
    withName: /.*:COSAG_ROUND2:COASSEMBLY_ROUND:UPDATE_CLUSTER_JSON$/ {
        publishDir = [
            path:    { "${params.outdir}/${params.out_co_assemblies}/cluster_json/round2" },
            mode:    params.publish_dir_mode,
            pattern: "updated_clusters.json"
        ]
    }

    withName: /.*:COASSEMBLY(?::[^:]+)*:FILTER_HIGH_CONTAM$/ {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
        publishDir = [
            [
                path:    { "${params.outdir}/${params.out_co_assemblies}/filtered_clusters/json" },
                mode:    params.publish_dir_mode,
                pattern: "filtered_clusters/*.json"
            ],
            [
                path:    { "${params.outdir}/${params.out_logs_diagnostics}/filtering/high_contamination" },
                mode:    params.publish_dir_mode,
                pattern: "filter_contam.log"
            ]
        ]
    }

    withName: /.*:COASSEMBLY(?::[^:]+)*:COSAG_OPTIMIZATION$/ {
        cpus   = 4
        memory = '16.GB'
        time   = '4.h'
        publishDir = [
            [
                path:    { "${params.outdir}/${params.out_co_assemblies}/tnf_optimization/results/${meta.id}" },
                mode:    params.publish_dir_mode,
                pattern: "*_output/*_tnf_optimized.json"
            ],
            [
                path:    { "${params.outdir}/${params.out_co_assemblies}/tnf_optimization/logs/${meta.id}" },
                mode:    params.publish_dir_mode,
                pattern: "*_sag_opt.log"
            ]
        ]
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MODULE 4 — Quality and taxonomy
    // ─────────────────────────────────────────────────────────────────────────
    withName: /.*:QUALITY_TAXONOMY:GTDBTK_COSAG$/ {
        cpus   = 24
        memory = '120.GB'
        time   = '24.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_taxonomic_classification}/co_assemblies/gtdb_results" },
            mode:    params.publish_dir_mode,
            pattern: "gtdb_results/*"
        ]
    }

    withName: /.*:QUALITY_TAXONOMY:EXTRACT_COSAG_CONTIGS$/ {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
        publishDir = [
            [
                path:    { "${params.outdir}/${params.out_co_assemblies}/selected_cosags/fasta" },
                mode:    params.publish_dir_mode,
                pattern: "selected_fastas/*.fasta"
            ],
            [
                path:    { "${params.outdir}/${params.out_co_assemblies}/selected_cosags/metadata" },
                mode:    params.publish_dir_mode,
                pattern: "selected_fastas/selected_contigs.tsv"
            ]
        ]
    }

    withName: /.*:QUALITY_TAXONOMY:BARRNAP_COSAG$/ {
        cpus   = 4
        memory = '8.GB'
        time   = '4.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_co_assemblies}/selected_cosags/barrnap" },
            mode:    params.publish_dir_mode,
            pattern: "*"
        ]
    }

    withName: /.*:QUALITY_TAXONOMY:UPDATE_CLUSTER_OPTIMIZED$/ {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_final_results}/cluster_json" },
            mode:    params.publish_dir_mode,
            pattern: "cluster_data_tnf.json"
        ]
    }

    withName: /.*:QUALITY_TAXONOMY:UPDATE_GTDBTK_RESULTS$/ {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_final_results}/cluster_json" },
            mode:    params.publish_dir_mode,
            pattern: "cluster_data_gtdbtk.json"
        ]
    }

    withName: /.*:QUALITY_TAXONOMY:ASSESS_HQ_MAG_FINAL$/ {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_final_results}/cluster_json" },
            mode:    params.publish_dir_mode,
            pattern: "cluster_data_gtdbtk.json"
        ]
    }
    withName: /.*:FORMAT_REPORT$/ {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_final_results}/report" },
            mode:    params.publish_dir_mode,
            pattern: "cosag_report.html"
        ]
    }
    withName: /.*:COASSEMBLY(?::[^:]+)*:PARSE_CLUSTER_JSON$/ {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
        publishDir = [
            path:    { "${params.outdir}/${params.out_logs_diagnostics}/cluster_json/parse" },
            mode:    params.publish_dir_mode,
            pattern: "clusters.tsv"
        ]
    }

    // -------------------------------------------------------------------------
    // ROUND2 dedicated publish paths (keep outputs separated from round1)
    // -------------------------------------------------------------------------
    withName: /COSAG_ROUND2:MINHASH_CLUSTER:SOURMASH_SKETCH$/ {
        publishDir = [
            path:    { "${params.outdir}/round2/${params.out_similarity_analysis}/signatures" },
            mode:    params.publish_dir_mode,
            pattern: "*.sig"
        ]
    }
    withName: /COSAG_ROUND2:MINHASH_CLUSTER:SOURMASH_COMPARE$/ {
        publishDir = [
            path:    { "${params.outdir}/round2/${params.out_similarity_analysis}/matrix" },
            mode:    params.publish_dir_mode,
            pattern: "sourmash_compare.log"
        ]
    }
    withName: /COSAG_ROUND2:MINHASH_CLUSTER:SOURMASH_PROCESS_MATRIX$/ {
        publishDir = [
            path:    { "${params.outdir}/round2/${params.out_similarity_analysis}/matrix" },
            mode:    params.publish_dir_mode,
            pattern: "*.{tsv,csv,txt}"
        ]
    }
    withName: /COSAG_ROUND2:MINHASH_CLUSTER:HIERARCHICAL_CLUSTER_MATRIX$/ {
        publishDir = [
            path:    { "${params.outdir}/round2/${params.out_clustering_analysis}/matrix" },
            mode:    params.publish_dir_mode,
            pattern: "*.{csv,txt}"
        ]
    }
    withName: /COSAG_ROUND2:MINHASH_CLUSTER:HIERARCHICAL_CLUSTER_ANALYSIS$/ {
        publishDir = [
            [
                path:    { "${params.outdir}/round2/${params.out_clustering_analysis}/results" },
                mode:    params.publish_dir_mode,
                pattern: "*.{tsv,txt}"
            ],
            [
                path:    { "${params.outdir}/round2/${params.out_clustering_analysis}/results" },
                mode:    params.publish_dir_mode,
                pattern: "dendrogram.png"
            ]
        ]
    }
    withName: /COSAG_ROUND2:MINHASH_CLUSTER:HIERARCHICAL_CLUSTER_REPORT$/ {
        publishDir = [
            path:    { "${params.outdir}/round2/${params.out_clustering_analysis}/summary" },
            mode:    params.publish_dir_mode,
            pattern: "*.{tsv,txt}"
        ]
    }
    withName: /COSAG_ROUND2:MINHASH_CLUSTER:PREPARE_ROUND_JSON$/ {
        publishDir = [
            path:    { "${params.outdir}/round2/${params.out_clustering_analysis}/cluster_json/round2" },
            mode:    params.publish_dir_mode,
            pattern: "round2_clusters.json"
        ]
    }

    withName: /COSAG_ROUND2:COASSEMBLY_ROUND:SPADES_COASSEMBLY$/ {
        publishDir = [
            [
                path:    { "${params.outdir}/round2/${params.out_co_assemblies}/coassembly/${meta.id}/contigs" },
                mode:    params.publish_dir_mode,
                pattern: "*_contigs.fasta"
            ],
            [
                path:    { "${params.outdir}/round2/${params.out_co_assemblies}/coassembly/${meta.id}/logs" },
                mode:    params.publish_dir_mode,
                pattern: "*_spades.log"
            ]
        ]
    }
    withName: /COSAG_ROUND2:COASSEMBLY_ROUND:CHECKM2$/ {
        publishDir = [
            [
                path:    { "${params.outdir}/round2/${params.out_co_assemblies}/checkm2" },
                mode:    params.publish_dir_mode,
                pattern: "checkm2_results/quality_report.tsv"
            ],
            [
                path:    { "${params.outdir}/round2/${params.out_logs_diagnostics}/checkm2/coassemblies" },
                mode:    params.publish_dir_mode,
                pattern: "checkm2_results.log"
            ]
        ]
    }
    withName: /COSAG_ROUND2:COASSEMBLY_ROUND:UPDATE_CLUSTER_JSON$/ {
        publishDir = [
            path:    { "${params.outdir}/round2/${params.out_co_assemblies}/cluster_json/round2" },
            mode:    params.publish_dir_mode,
            pattern: "updated_clusters.json"
        ]
    }
    withName: /COSAG_ROUND2:COASSEMBLY_ROUND:COSAG_OPTIMIZATION$/ {
        publishDir = [
            [
                path:    { "${params.outdir}/round2/${params.out_co_assemblies}/tnf_optimization/results/${meta.id}" },
                mode:    params.publish_dir_mode,
                pattern: "*_output/*_tnf_optimized.json"
            ],
            [
                path:    { "${params.outdir}/round2/${params.out_co_assemblies}/tnf_optimization/logs/${meta.id}" },
                mode:    params.publish_dir_mode,
                pattern: "*_sag_opt.log"
            ]
        ]
    }

    withName: /COSAG_ROUND2:QUALITY_TAXONOMY:UPDATE_CLUSTER_OPTIMIZED$/ {
        publishDir = [
            path:    { "${params.outdir}/round2/${params.out_final_results}/cluster_json" },
            mode:    params.publish_dir_mode,
            pattern: "cluster_data_tnf.json"
        ]
    }
    withName: /COSAG_ROUND2:QUALITY_TAXONOMY:EXTRACT_COSAG_CONTIGS$/ {
        publishDir = [
            [
                path:    { "${params.outdir}/round2/${params.out_co_assemblies}/selected_cosags/fasta" },
                mode:    params.publish_dir_mode,
                pattern: "selected_fastas/*.fasta"
            ],
            [
                path:    { "${params.outdir}/round2/${params.out_co_assemblies}/selected_cosags/metadata" },
                mode:    params.publish_dir_mode,
                pattern: "selected_fastas/selected_contigs.tsv"
            ]
        ]
    }
    withName: /COSAG_ROUND2:QUALITY_TAXONOMY:BARRNAP_COSAG$/ {
        publishDir = [
            path:    { "${params.outdir}/round2/${params.out_co_assemblies}/selected_cosags/barrnap" },
            mode:    params.publish_dir_mode,
            pattern: "*"
        ]
    }
    withName: /COSAG_ROUND2:QUALITY_TAXONOMY:GTDBTK_COSAG$/ {
        publishDir = [
            path:    { "${params.outdir}/round2/${params.out_taxonomic_classification}/co_assemblies/gtdb_results" },
            mode:    params.publish_dir_mode,
            pattern: "gtdb_results/*"
        ]
    }
    withName: /COSAG_ROUND2:QUALITY_TAXONOMY:UPDATE_GTDBTK_RESULTS_SAG$/ {
        publishDir = [
            path:    { "${params.outdir}/round2/${params.out_final_results}/cluster_json" },
            mode:    params.publish_dir_mode,
            pattern: "cluster_data_gtdbtk.json"
        ]
    }
    withName: /COSAG_ROUND2:QUALITY_TAXONOMY:UPDATE_GTDBTK_RESULTS_COSAG$/ {
        publishDir = [
            path:    { "${params.outdir}/round2/${params.out_final_results}/cluster_json" },
            mode:    params.publish_dir_mode,
            pattern: "cluster_data_gtdbtk.json"
        ]
    }
    withName: /COSAG_ROUND2:QUALITY_TAXONOMY:ASSESS_HQ_MAG_FINAL$/ {
        publishDir = [
            path:    { "${params.outdir}/round2/${params.out_final_results}/cluster_json" },
            mode:    params.publish_dir_mode,
            pattern: "cluster_data_gtdbtk.json"
        ]
    }
    withName: /COSAG_ROUND2:FORMAT_REPORT$/ {
        publishDir = [
            path:    { "${params.outdir}/round2/${params.out_final_results}/report" },
            mode:    params.publish_dir_mode,
            pattern: "cosag_report.html"
        ]
    }
}