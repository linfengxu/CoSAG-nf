/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Placeholder test profile: validates config and schema wiring.
    Full end-to-end nf-test requires CheckM2/GTDB databases and real FASTQ paths
    (not yet on nf-core/test-datasets). See docs/usage.md.

    Use as follows:
        nextflow run linfengxu/CoSAG-nf -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Placeholder profile for CI/schema checks (no public mini dataset yet)'

    input          = "${projectDir}/assets/samplesheet.csv"
    outdir         = './results_test'
    checkm2_db     = "${projectDir}/assets/hq_mag_dummy"
    gtdb_database  = "${projectDir}/assets/hq_mag_dummy"
    validate_params = false
}
